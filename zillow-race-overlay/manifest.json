{
  "manifest_version": 3,
  "name": "Zillow Map Overlays: Race, DC Metro, Road Distance",
  "version": "1.2.0",
  "description": "Adds ACS race dot density (Esri Living Atlas), DC Metrorail lines, and a two-click road-distance tool to Zillow's map.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://services.arcgis.com/*",
    "https://maps2.dcgis.dc.gov/*",
    "https://router.project-osrm.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Zillow map overlays",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zillow.com/*"
      ],
      "js": [
        "config.js",
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.zillow.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
